<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 520" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2e251e" />
      <stop offset="100%" stop-color="#4f3c30" />
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#d4ac0d" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#d4ac0d" stop-opacity="0" />
    </radialGradient>
    <pattern id="canaryPattern" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 0 20 L 20 0 L 40 20 L 20 40 Z" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1"/>
    </pattern>
  </defs>

  <!-- Fondo degradado -->
  <rect width="800" height="520" fill="url(#bgGrad)" />
  <rect width="800" height="520" fill="url(#canaryPattern)" />
  <circle cx="400" cy="210" r="240" fill="url(#glow)" />

  <!-- Marco decorativo -->
  <rect x="25" y="25" width="750" height="470" rx="16" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
  <rect x="35" y="35" width="730" height="450" rx="12" fill="none" stroke="#d4ac0d" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="8 6" />

  <!-- Emblema / Icono central -->
  <g transform="translate(400, 195)">
    <circle r="72" fill="rgba(0,0,0,0.35)" stroke="#d4ac0d" stroke-width="2.5" />
    <circle r="60" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="1" />
    <text font-family="'Segoe UI Emoji', 'Apple Color Emoji', sans-serif" font-size="64" text-anchor="middle" dominant-baseline="central">🧁</text>
  </g>

  <!-- Sello La Palma -->
  <g transform="translate(400, 75)">
    <rect x="-110" y="-14" width="220" height="28" rx="14" fill="rgba(0,0,0,0.4)" stroke="#d4ac0d" stroke-width="1" />
    <text font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="11" font-weight="700" letter-spacing="2.5" fill="#f5ede3" text-anchor="middle" dominant-baseline="central">TARCA LUIS • LA PALMA</text>
  </g>

  <!-- Título y subtítulo -->
  <text x="400" y="340" font-family="Georgia, 'Times New Roman', serif" font-size="30" font-weight="bold" fill="#ffffff" text-anchor="middle" letter-spacing="0.5">Mousse de Gofio</text>
  <text x="400" y="380" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="15" fill="#e0d5c8" text-anchor="middle" letter-spacing="0.3">Espuma ligera con miel de la cumbre</text>

  <!-- Detalle decorativo inferior -->
  <line x1="320" y1="415" x2="480" y2="415" stroke="#d4ac0d" stroke-width="2" stroke-linecap="round" />
  <circle cx="400" cy="415" r="4" fill="#d4ac0d" />
</svg>